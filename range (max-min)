import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        // Read array
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        // Sort array
        Arrays.sort(arr);

        // Print sorted array
        System.out.print("Sorted Array: ");
        for (int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }

        // Find max and min
        int min = arr[0];
        int max = arr[n - 1];

        System.out.println("\nMinimum = " + min);
        System.out.println("Maximum = " + max);
        System.out.println("Range = " + (max - min));

        
    }
}
