import java.util.*;

public class Solution {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        for(int i = 0; i < n; i++){
            arr[i] = sc.nextInt();
        }                                 
        int[] dp = new int[n + 1];
        dp[0] = 0;
        for(int i = 1; i <= n; i++){
            dp[i] = 0;
            boolean[] present = new boolean[1005];
            int mex = 0;
            for(int j = i; j >= 1; j--){
                present[arr[j - 1]] = true;
                while(present[mex]){
                    mex++;
                }
                dp[i] = Math.max(dp[i], dp[j - 1] + mex);
            }
        }
        System.out.println(dp[n]);
    }
}
